// store — multi-tenant e-commerce platform
// Every business row carries storeId: one database, many shops.
// Money is stored as integer Rappen (1 CHF = 100), prices are VAT-inclusive (B2C).
// Localized text is stored as JSON: { "de": "...", "fr": "...", "it": "...", "en": "..." }.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LocationType {
  WAREHOUSE
  RETAIL
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Store {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  defaultLocale    String   @default("de")
  locales          String[] @default(["de", "fr", "it", "en"])
  currency         String   @default("CHF")
  vatRateBp        Int      @default(810) // 8.1 % in basis points
  shippingFlat     Int      @default(900) // CHF 9.00
  freeShippingFrom Int?     @default(10000) // free from CHF 100.00
  contactEmail     String?
  orderCounter     Int      @default(1000)
  // Storefront trust strip: each promise shows only when the store has set it.
  returnDays       Int? // e.g. 30 → "returns within 30 days"
  originalGoods    Boolean  @default(false) // the store states it sells new, original goods
  paymentMethods   String[] @default([]) // enabled in Stripe, e.g. ["card", "twint"]; shown only with Stripe configured
  // Storefront home. Localized texts; a part without text is not shown.
  announcement     Json? // bar above the header, on every page
  announcementHref String? // its link: a path after the locale ("/" = catalogue, "/collections/sport") or a full URL
  bannerEyebrow    Json? // home banner: small line above the title
  bannerTitle      Json? // banner title; no title → no banner
  bannerText       Json? // one line under the title
  // Square store icon (browser tab, phone home screen): an image URL or a path in /public. None → the store's
  // initials on the accent colour, generated.
  iconUrl          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  domains     Domain[]
  staff       StaffUser[]
  categories  Category[]
  brands      Brand[]
  collections Collection[]
  products    Product[]
  locations   Location[]
  customers   Customer[]
  orders      Order[]
}

model Domain {
  id        String   @id @default(cuid())
  host      String   @unique // e.g. "shop.client-domain.ch"
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model StaffUser {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  passwordHash String?
  role         StaffRole @default(STAFF)
  createdAt    DateTime  @default(now())

  @@unique([storeId, email])
}

model Category {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug     String
  name     Json // Localized
  position Int       @default(0)
  products Product[]

  @@unique([storeId, slug])
}

model Brand {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug     String
  name     String // a brand name is the same in every language
  logoUrl  String?
  position Int       @default(0)
  products Product[]

  @@unique([storeId, slug])
}

// Hand-picked groups of products: the header navigation (Herren, Damen, …) and the home banner.
model Collection {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug     String
  name     Json // Localized
  headline Json? // Localized banner title; falls back to the name
  position Int       @default(0)
  inNav    Boolean   @default(false)
  featured Boolean   @default(false) // the banner on the store's home page
  products Product[]

  @@unique([storeId, slug])
}

model Product {
  id           String        @id @default(cuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId      String?
  brand        Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  collections  Collection[]
  slug         String
  title        Json // Localized
  description  Json? // Localized
  status       ProductStatus @default(DRAFT)
  images       String[]
  optionNames  String[] // e.g. ["size", "color"]
  // Translations of option values; variants store the German value.
  // e.g. { "color": { "Schwarz": { "fr": "Noir", "it": "Nero", "en": "Black" } } }
  optionValues Json?
  isNew        Boolean       @default(false) // "New" badge on the product card
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  variants ProductVariant[]

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt])
  @@index([brandId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String
  price          Int // Rappen, VAT-inclusive
  compareAtPrice Int?
  options        Json // e.g. { "size": "M", "color": "Black" }
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  inventory  InventoryLevel[]
  orderItems OrderItem[]

  @@index([productId])
}

// Online warehouse now, FoxTown retail store later — same stock model.
model Location {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  type        LocationType     @default(WAREHOUSE)
  sellsOnline Boolean          @default(true)
  inventory   InventoryLevel[]
}

model InventoryLevel {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int            @default(0)

  @@unique([variantId, locationId])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([storeId, email])
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number          Int
  status          OrderStatus @default(PENDING)
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email           String
  locale          String
  currency        String      @default("CHF")
  subtotal        Int
  shipping        Int
  vatAmount       Int // VAT contained in total
  total           Int
  shippingAddress Json
  paymentProvider String? // "stripe" | "test"
  paymentRef      String?     @unique
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]

  @@unique([storeId, number])
  @@index([storeId, status])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title     String // snapshot at purchase time
  sku       String
  options   Json
  unitPrice Int
  quantity  Int
  lineTotal Int
}
