// store — multi-tenant e-commerce platform
// Every business row carries storeId: one database, many shops.
// Money is stored as integer Rappen (1 CHF = 100), prices are VAT-inclusive (B2C).
// Localized text is stored as JSON: { "de": "...", "fr": "...", "it": "...", "en": "..." }.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LocationType {
  WAREHOUSE
  RETAIL
}

/**
 * Which part of the store a product is shown in: Outlet, Neu, Second Story (PRELOVED; the name is a text only).
 */
enum ProductLine {
  NEW
  OUTLET
  PRELOVED
}

/**
 * Condition of a PRELOVED item (one item: on the product).
 */
enum ItemCondition {
  NEW_WITH_TAGS
  LIKE_NEW
  VERY_GOOD
  GOOD
}

enum SellerType {
  HOUSE // the store itself
  BRAND // a brand selling its own goods
  SHOP // an outlet or retail shop
  PRIVATE // a private person: PRELOVED only (checked in code and by a database trigger)
}

enum SellerStatus {
  PENDING
  ACTIVE
  PAUSED
  BLOCKED
}

/**
 * What a crossed-out price compares with (Swiss price indication rules; legal check pending).
 */
enum CompareAtPriceType {
  OUR_PREVIOUS
  MANUFACTURER_RRP
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Store {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  defaultLocale    String   @default("de")
  locales          String[] @default(["de", "fr", "it", "en"])
  currency         String   @default("CHF")
  vatRateBp        Int      @default(810) // 8.1 % in basis points
  shippingFlat     Int      @default(900) // CHF 9.00
  freeShippingFrom Int?     @default(10000) // free from CHF 100.00
  contactEmail     String?
  orderCounter     Int      @default(1000)
  // Storefront trust strip: each promise shows only when the store has set it.
  returnDays       Int? // e.g. 30 → "returns within 30 days"
  originalGoods    Boolean  @default(false) // the store states it sells new, original goods
  paymentMethods   String[] @default([]) // enabled in Stripe, e.g. ["card", "twint"]; shown only with Stripe configured
  // Storefront home. Localized texts; a part without text is not shown.
  announcement     Json? // bar above the header, on every page
  announcementHref String? // its link: a path after the locale ("/" = catalogue, "/collections/sport") or a full URL
  bannerEyebrow    Json? // home banner: small line above the title
  bannerTitle      Json? // banner title; no title → no banner
  bannerText       Json? // one line under the title
  bannerEnabled    Boolean  @default(false) // the home banner is shown only when switched on
  bannerImageUrl   String? // banner picture: an image URL or a path in /public
  bannerHref       Json? // localized link of the banner button: a path after the locale or a full URL; none → the products
  // Square store icon (browser tab, phone home screen): an image URL or a path in /public. None → the store's
  // initials on the accent colour, generated.
  iconUrl          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  domains     Domain[]
  staff       StaffUser[]
  categories  Category[]
  brands      Brand[]
  collections Collection[]
  products    Product[]
  sellers     Seller[]
  locations   Location[]
  customers   Customer[]
  orders      Order[]
}

model Domain {
  id        String   @id @default(cuid())
  host      String   @unique // e.g. "shop.client-domain.ch"
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model StaffUser {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  passwordHash String?
  role         StaffRole @default(STAFF)
  createdAt    DateTime  @default(now())

  @@unique([storeId, email])
}

model Category {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug     String
  name     Json // Localized
  position Int       @default(0)
  products Product[]

  @@unique([storeId, slug])
}

model Brand {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug     String
  name     String // a brand name is the same in every language
  logoUrl  String?
  position Int       @default(0)
  products Product[]
  sellers  Seller[]

  @@unique([storeId, slug])
}

// Hand-picked groups of products: the header navigation (Herren, Damen, …) and the home banner.
model Collection {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug         String
  name         Json // Localized
  headline     Json? // Localized banner title; falls back to the name
  position     Int       @default(0)
  inNav        Boolean   @default(false)
  featured     Boolean   @default(false) // the banner on the store's home page
  // Category picture (URL or path in /public), kept for later; not shown yet.
  tileImageUrl String?
  products     Product[]

  @@unique([storeId, slug])
}

/**
 * Who sells a product: the store itself (HOUSE, one per store, slug "house"), a brand, a shop, a private person.
 * A brand and a seller are different things: a shop may sell many brands; a BRAND seller may link its Brand.
 */
model Seller {
  id        String       @id @default(cuid())
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      SellerType
  name      String
  slug      String
  status    SellerStatus @default(PENDING)
  brandId   String?
  brand     Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  products  Product[]

  @@unique([storeId, slug])
  @@unique([id, storeId]) // target of Product's (sellerId, storeId): a product's seller is in its store
  @@index([storeId, type])
}

model Product {
  id           String         @id @default(cuid())
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       Seller         @relation(fields: [sellerId, storeId], references: [id, storeId], onDelete: Restrict)
  line         ProductLine    @default(NEW)
  condition    ItemCondition? // PRELOVED only; the database checks line = PRELOVED ⇔ condition set
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId      String?
  brand        Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  collections  Collection[]
  slug         String
  title        Json // Localized
  description  Json? // Localized
  status       ProductStatus  @default(DRAFT)
  images       String[]
  // Credit per photo, in the order of images: [{ author, authorUrl, photoUrl, source }] (Unsplash requires it);
  // null for the store's own photos.
  imageCredits Json?
  optionNames  String[] // e.g. ["size", "color"]
  // Translations of option values; variants store the German value.
  // e.g. { "color": { "Schwarz": { "fr": "Noir", "it": "Nero", "en": "Black" } } }
  optionValues Json?
  isNew        Boolean        @default(false) // "New" badge on the product card
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  variants ProductVariant[]

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt])
  @@index([storeId, line, status, createdAt])
  @@index([storeId, sellerId])
  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id                  String              @id @default(cuid())
  productId           String
  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                 String
  price               Int // Rappen, VAT-inclusive
  compareAtPrice      Int?
  // Set exactly when compareAtPrice is (database check); since when the former price applies (PBV, optional).
  compareAtPriceType  CompareAtPriceType?
  compareAtPriceSince DateTime?
  options             Json // e.g. { "size": "M", "color": "Black" }
  position            Int                 @default(0)
  createdAt           DateTime            @default(now())

  inventory  InventoryLevel[]
  orderItems OrderItem[]

  @@index([productId])
}

// Online warehouse now, FoxTown retail store later — same stock model.
model Location {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  type        LocationType     @default(WAREHOUSE)
  sellsOnline Boolean          @default(true)
  inventory   InventoryLevel[]
}

model InventoryLevel {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int            @default(0)

  @@unique([variantId, locationId])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([storeId, email])
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number          Int
  status          OrderStatus @default(PENDING)
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email           String
  locale          String
  currency        String      @default("CHF")
  subtotal        Int
  shipping        Int
  vatAmount       Int // VAT contained in total
  total           Int
  shippingAddress Json
  paymentProvider String? // "stripe" | "test"
  paymentRef      String?     @unique
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]

  @@unique([storeId, number])
  @@index([storeId, status])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title     String // snapshot at purchase time
  sku       String
  options   Json
  unitPrice Int
  quantity  Int
  lineTotal Int
}
