# Postgres (Neon in production). Neon: use the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/the_stores"

# Host of the platform itself. Stores live on <slug>.ROOT_DOMAIN or on their own domain.
# Local: localhost:3000  ·  Production: e.g. your-domain.ch
ROOT_DOMAIN="localhost:3000"

# Store that / and /<locale> on ROOT_DOMAIN redirect to (default: the seeded "demo").
DEFAULT_STORE_SLUG="demo"

# Admin area password (HTTP Basic auth, any username). Required in production.
ADMIN_PASSWORD=""

# Stripe — leave empty for test mode (orders are marked paid instantly, no real payment).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
